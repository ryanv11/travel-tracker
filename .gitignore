# Dependencies
node_modules/
npm-debug.log

# Database files — the live database should not be in version control
*.db
*.sqlite
*.sqlite3

# macOS system files
.DS_Store
.AppleDouble

# Environment files — may contain API keys or machine-specific paths
.env
.env.local
.env.production
.env*.local

# Agent diagnostic credentials (ADL-33/OP-21) — operator secrets for read-only
# Railway/Turso access, separate from the app's own runtime secrets above.
# Never loaded by the app's dotenv config; sourced only for diagnostic scripts.
.env.agent-diagnostics

# SQLite WAL mode sidecar files
*.db-shm
*.db-wal

# Build outputs
dist/
build/
.cache/

# Drizzle config compiled output (drizzle-kit compiles drizzle.config.ts at runtime)
drizzle.config.js
drizzle.config.js.map
drizzle.config.d.ts
drizzle.config.d.ts.map

# Logs
*.log
logs/
claude-code/


# Playwright / E2E test artefacts
e2e.db
playwright-report/
test-results/

# Personal Claude Code overrides — machine-specific permissions, notification hooks
.claude/settings.local.json

# macOS notification bridge — runtime trigger files only; .claude/notify/host-setup/
# (the watcher script + LaunchAgent plist) is checked in, see .claude/hooks/notify.sh
.claude/notify/queue/
