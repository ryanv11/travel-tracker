{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/block-db-push.sh"
          },
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/no-protected-commit.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/typecheck.sh"
          },
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/drift-ledger.sh"
          },
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/negative-findings-guard.sh"
          },
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/no-wholesale-rewrite.sh"
          },
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/atdd-first-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/negative-findings-guard.sh"
          },
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/atdd-first-guard.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/subagent-stop.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/session-end.sh"
          }
        ]
      }
    ]
  }
}
