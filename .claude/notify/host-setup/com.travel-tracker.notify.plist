<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE: __HOME__ and __REPO__ are filled in at install time (see README.md).
     launchd does not expand ~ or $HOME, and ADL-39 forbids committing a host path. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.travel-tracker.notify</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/travel-tracker-notify</string>
    <string>__HOME__/.local/share/travel-tracker/notify-watch.sh</string>
    <string>__REPO__/.claude/notify/queue</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/travel-tracker-notify.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/travel-tracker-notify.err</string>
</dict>
</plist>
